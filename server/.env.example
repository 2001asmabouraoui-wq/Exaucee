# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Gmail (use an App Password — NOT your real password)
# Guide: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The email address that receives order notifications (can be same as GMAIL_USER)
ADMIN_EMAIL=your@gmail.com

# A secret password to protect the admin API (choose anything)
ADMIN_SECRET=choose-a-strong-secret-here

# Your frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Port (Render sets this automatically)
PORT=3001
